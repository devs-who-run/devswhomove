{
  "name": "devs-who-move",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && wrangler dev",
    "dev:ui": "ng serve --proxy-config proxy.conf.json",
    "dev:api": "wrangler dev",
    "build": "ng build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply devs-who-move --local",
    "db:remote": "wrangler d1 migrations apply devs-who-move --remote",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261103.0-beta",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.157.0"
  }
}
