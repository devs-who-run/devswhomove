{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devs-who-move",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/devs-who-move/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devs-who-move",
      // Replace with the ID returned by `pnpm exec wrangler d1 create devs-who-move` before deploying.
      "database_id": "dbf6f9e3-dd68-413e-8cf0-979319d9d2cc",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      // Create once with `pnpm exec wrangler r2 bucket create devs-who-move-photos`.
      "bucket_name": "devs-who-move-photos",
    },
  ],
  "vars": {
    "APP_URL": "https://devswhorun.dev/",
  },
  "observability": { "enabled": true },
}
